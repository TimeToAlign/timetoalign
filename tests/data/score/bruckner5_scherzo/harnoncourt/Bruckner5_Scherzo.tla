          "kind": "MARKER",
          "hash": "2f5ee9ae5a909aad979cdc483a773d2b"
        },
        "1260": {
          "time": 147.59805297851562,
          "comments": "",
          "label": "\"verschwind\"",
          "color": null,
          "kind": "MARKER",
          "hash": "944e4b5e32c8cf0362aa80396c9d6916"
        },
        "1261": {
          "time": 154.8325595566664,
          "comments": "Diese Aussage ist etwas widerspr\u00fcchlich, weil er eigentlich ja Motiv 6. der II. Themengruppe zuordnet.",
