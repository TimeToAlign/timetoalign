      "components": {
        "1254": {
          "time": 0.4846961468425476,
          "comments": "",
          "label": "\"Aus dem Nichts\"",
          "color": null,
          "kind": "MARKER",
          "hash": "67c3fec110cba4ac99b0c551ed45ca92"
        },
        "1255": {
          "time": 42.73828753196383,
          "comments": "",
          "label": "stillst",
          "color": null,
          "kind": "MARKER",
          "hash": "06c0dc03f0b34cdb4a5e3b1c207c3709"
        },
        "1256": {
          "time": 50.58339784605033,
          "comments": "",
          "label": "\"geh\u00f6rt wohl auch im schnellen Tpo z. II. Th. (siehe Durchf.)\"",
          "color": null,
          "kind": "MARKER",
          "hash": "676b84977b1fa360b81a443967be082b"
        },
        "1257": {
          "time": 84.94520422852517,
          "comments": "halb ausradiert",
          "label": "\"dieser wohl III. Teil kommt in der Durchf. nicht vor\"",
          "color": null,
          "kind": "MARKER",
          "hash": "ed0b235a2e155e01e28f171619ccd171"
        },
        "1258": {
          "time": 127.53980255126953,
          "comments": "",
          "label": "\"1. H\u00f6heP. d. Durchf.\"",
          "color": null,
